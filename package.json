{
  "name": "live-translate-mcp",
  "version": "0.1.6",
  "mcpName": "dev.waxberry/live-translate-mcp",
  "description": "MCP server for local speech translation (EN ↔ 中文) via Whisper + Claude + Piper",
  "repository": {
    "type": "git",
    "url": "https://github.com/waxberry-dev/live-translate-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "live-translate-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "onnxruntime-node": "1.21.0"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.21.0"
    },
    "onlyBuiltDependencies": ["onnxruntime-node"]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
