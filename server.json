{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.waxberry/live-translate-mcp",
  "description": "MCP server for local speech translation (EN ↔ 中文) via Whisper + Claude + Piper",
  "repository": {
    "url": "https://github.com/waxberry-dev/live-translate-mcp",
    "source": "github"
  },
  "version": "0.1.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "live-translate-mcp",
      "version": "0.1.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Anthropic API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "ANTHROPIC_API_KEY"
        }
      ]
    }
  ]
}
